{
	"name": "fluvial",
	"version": "0.6.1",
	"description": "Fluvial:  A light http/2 server framework, similar to Express",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist/**/*",
		"README.md"
	],
	"type": "module",
	"scripts": {
		"ex": "tsx",
		"compile": "tsc --project tsconfig.src.json",
		"test": "pnpm test:base src/**/*.test.ts",
		"test:base": "pnpm ex --tsconfig=tsconfig.test.json --test",
		"test:e2e": "pnpm test:base src/**/*.e2e.ts",
		"test:coverage": "pnpm test:base --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=dist/lcov.info --test-reporter=tap --test-reporter-destination=dist/tap.info src/**/*.test.ts",
		"prepublish": "pnpm test && pnpm compile"
	},
	"keywords": [
		"http/2",
		"http2",
		"stream",
		"server",
		"back-end",
		"backend"
	],
	"author": {
		"email": "sskeen9@gmail.com",
		"name": "Samuel Skeen",
		"url": "https://github.com/cwadrupldijjit"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/fluvialjs/fluvial.git",
		"directory": "packages/core"
	},
	"license": "GPL-3.0-only",
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"playwright": "catalog:",
		"pnpm": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"dependencies": {
		"mime": "^4.1.0"
	}
}
